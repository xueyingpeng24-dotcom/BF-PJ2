    "# ==========================================================\n",
    "# KPI Card\n",
    "# Total Sales Forecast (Next 6 Weeks)\n",
    "# ==========================================================\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# KPI\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "total_sales = company_weekly[\"sales_prediction\"].sum() / 1_000_000\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# Card\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "fig, ax = plt.subplots(\n",
    "    figsize=(8, 4.8)\n",
    ")\n",
    "\n",
    "ax.axis(\"off\")\n",
    "\n",
    "# Border\n",
    "card = plt.Rectangle(\n",
    "    (0.05, 0.08),\n",
    "    0.90,\n",
    "    0.84,\n",
    "    fill=False,\n",
    "    linewidth=2.5,\n",
    "    edgecolor=\"#4F4F4F\"\n",
    ")\n",
    "\n",
    "ax.add_patch(card)\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# Title\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "ax.text(\n",
    "\n",
    "    0.5,\n",
    "\n",
    "    0.78,\n",
    "\n",
    "    \"TOTAL SALES FORECAST\",\n",
    "\n",
    "    ha=\"center\",\n",
    "\n",
    "    fontsize=20,\n",
    "\n",
    "    fontweight=\"bold\"\n",
    "\n",
    ")\n",
    "\n",
    "ax.text(\n",
    "\n",
    "    0.5,\n",
    "\n",
    "    0.70,\n",
    "\n",
    "    \"NEXT 6 WEEKS\",\n",
    "\n",
    "    ha=\"center\",\n",
    "\n",
    "    fontsize=16,\n",
    "\n",
    "    color=\"gray\"\n",
    "\n",
    ")\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# KPI Number\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "ax.text(\n",
    "\n",
    "    0.5,\n",
    "\n",
    "    0.48,\n",
    "\n",
    "    f\"{total_sales:.1f} M\",\n",
    "\n",
    "    ha=\"center\",\n",
    "\n",
    "    fontsize=41,\n",
    "\n",
    "    fontweight=\"bold\",\n",
    "\n",
    "    color=\"#2F6DB2\"\n",
    "\n",
    ")\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# Subtitle\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "ax.text(\n",
    "\n",
    "    0.5,\n",
    "\n",
    "    0.22,\n",
    "\n",
    "    \"Company-wide Forecast\",\n",
    "\n",
    "    ha=\"center\",\n",
    "\n",
    "    fontsize=15,\n",
    "\n",
    "    color=\"gray\"\n",
    "\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "\n",
    "    processed_dir / \"kpi_total_sales_6weeks.png\",\n",
    "\n",
    "    dpi=300,\n",
    "\n",
    "    bbox_inches=\"tight\"\n",
    "\n",
    ")\n",
    "\n",
    "plt.show()"

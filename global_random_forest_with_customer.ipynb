    "\n",
    "print(\"=\" * 60)\n",
    "print(\"Forecast Period\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "print(\n",
    "    future_result[\"ds\"].min(),\n",
    "    \"to\",\n",
    "    future_result[\"ds\"].max()\n",
    ")\n",
    "\n",
    "print(f\"Rows: {len(future_result):,}\")\n",
    "\n",

   "cell_type": "code",
   "source": [
    "# ==========================================================\n",
    "# Weekly Sales Forecast by Store Type\n",
    "# Stacked Area Chart\n",
    "# ==========================================================\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# Pivot Table\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "area_data = (\n",
    "\n",
    "    store_type_weekly\n",
    "\n",
    "    .pivot(\n",
    "\n",
    "        index=\"forecast_week\",\n",
    "\n",
    "        columns=\"store_type\",\n",
    "\n",
    "        values=\"sales_prediction\"\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "# 保证顺序\n",
    "area_data = area_data[\n",
    "    [\"a\", \"b\", \"c\", \"d\"]\n",
    "]\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# Plot\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "fig, ax = plt.subplots(\n",
    "    figsize=(13, 6)\n",
    ")\n",
    "\n",
    "ax.stackplot(\n",
    "\n",
    "    area_data.index,\n",
    "\n",
    "    area_data[\"b\"],\n",
    "    area_data[\"c\"],\n",
    "    area_data[\"d\"],\n",
    "    area_data[\"a\"],\n",
    "\n",
    "    labels=[\n",
    "        \"Type B\",\n",
    "        \"Type C\",\n",
    "        \"Type D\",\n",
    "        \"Type A\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# COO Highlight\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "ax.axvspan(\n",
    "\n",
    "    0.8,\n",
    "\n",
    "    2.2,\n",
    "\n",
    "    color=\"#FDE9D9\",\n",
    "\n",
    "    alpha=0.35,\n",
    "\n",
    "    label=\"Weeks 1–2 (COO Focus)\"\n",
    "\n",
    ")\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# Layout\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "ax.set_title(\n",
    "\n",
    "    \"Weekly Sales Forecast by Store Type\",\n",
    "\n",
    "    fontsize=20,\n",
    "\n",
    "    fontweight=\"bold\"\n",
    "\n",
    ")\n",
    "\n",
    "ax.set_xlabel(\n",
    "\n",
    "    \"Forecast Week\",\n",
    "\n",
    "    fontsize=14\n",
    "\n",
    ")\n",
    "\n",
    "ax.set_ylabel(\n",
    "\n",
    "    \"Predicted Weekly Sales\",\n",
    "\n",
    "    fontsize=14\n",
    "\n",
    ")\n",
    "\n",
    "ax.set_xticks(range(1, 7))\n",
    "\n",
    "ax.grid(\n",
    "\n",
    "    linestyle=\"--\",\n",
    "\n",
    "    alpha=0.3\n",
    "\n",
    ")\n",
    "\n",
    "ax.legend(\n",
    "\n",
    "    loc=\"upper left\",\n",
    "\n",
    "    fontsize=10,\n",
    "\n",
    "    title=\"Store Type\"\n",
    "\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# Save\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "plt.savefig(\n",
    "\n",
    "    processed_dir / \"store_type_area_chart.png\",\n",
    "\n",
    "    dpi=300,\n",
    "\n",
    "    bbox_inches=\"tight\"\n",
    "\n",
    ")\n",
    "\n",
    "plt.show()"
   ],
